<div class="container" style="max-width:600px;margin:0 auto;padding:32px 16px;text-align:center;">
  <h2 style="font-size:20px;margin-bottom:8px;">iPad で読み取ってください</h2>
  <p style="color:#6b7280;font-size:14px;margin-bottom:8px;">
    <%= @user.try(:name) %> 様 ／ 有効期限 <%= l @intake_session.expires_at, format: :short %>
  </p>
  <%# 何のためのQRかを出す。新規記入と訂正で見た目が同じだと、
      スタッフが患者に違うものを渡しても気づけない。 %>
  <% if @intake_session.purpose_revision? %>
    <p style="background:#fef3c7;border-left:4px solid #f59e0b;padding:10px 14px;
              margin:0 0 16px;font-size:14px;color:#92400e;text-align:left;">
      <strong>修正用</strong>のリンクです。<br>
      <%= @intake_session.target_questionnaire.submitted_at ?
            l(@intake_session.target_questionnaire.submitted_at.to_date, format: :long) :
            "下書き" %> 提出分を修正します。<br>
      <span style="font-size:13px;">
        元の記録は残ります（新しい版として保存されます）。
      </span>
    </p>
  <% end %>

  <p style="color:#b45309;font-size:13px;margin-bottom:24px;">
    ※ この画面を再読み込みすると QR は表示できなくなります（再発行してください）
  </p>

  <div style="display:inline-block;padding:20px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;">
    <%= raw RQRCode::QRCode.new(@entry_url).as_svg(
          module_size: 6, standalone: true, use_path: true
        ) %>
  </div>

  <p style="margin-top:24px;font-size:13px;color:#9ca3af;word-break:break-all;">
    <%= @entry_url %>
  </p>

  <div style="margin-top:32px;display:flex;gap:12px;justify-content:center;">
    <%= link_to "カルテに戻る", karte_user_path(@user),
          style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;color:#374151;text-decoration:none;" %>
    <%= button_to "このリンクを無効化", karte_intake_session_path(@intake_session),
          method: :delete,
          style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;background:#fff;cursor:pointer;" %>
  </div>
</div>
