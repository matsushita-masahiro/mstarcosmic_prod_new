<div class="container" style="max-width:1200px;margin:0 auto;padding:24px 16px;">
  <h2 style="font-size:22px;margin-bottom:16px;">カルテ管理</h2>

  <%= form_with url: karte_users_path, method: :get, local: true,
                style: "margin-bottom:20px;display:flex;gap:8px;max-width:560px;" do %>
    <%= text_field_tag :q, @q,
          placeholder: "お名前・カナ・電話番号・会員No.（電話はハイフン有無どちらでも可）",
          style: "flex:1;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:15px;" %>
    <%= submit_tag "検索",
          style: "padding:10px 20px;border-radius:6px;border:1px solid #1d4ed8;background:#1d4ed8;color:#fff;cursor:pointer;" %>
    <% if @q.present? %>
      <%= link_to "クリア", karte_users_path,
            style: "padding:10px 16px;border-radius:6px;border:1px solid #d1d5db;color:#374151;text-decoration:none;line-height:2;" %>
    <% end %>
  <% end %>

  <p style="color:#6b7280;font-size:14px;">
    <%= @total %> 件
    <% if @total_pages > 1 %>
      （<%= @page %> / <%= @total_pages %> ページ）
    <% end %>
  </p>

  <table style="width:100%;border-collapse:collapse;font-size:15px;">
    <thead>
      <tr style="background:#f3f4f6;text-align:left;">
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">会員No.</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">お名前</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">カナ</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">生年月日</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">性別</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">同意書</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">問診票</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;"><%= user.karte_member_no %></td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;"><%= user.name %></td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;font-size:14px;color:#6b7280;">
            <%= user.name_kana %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;font-size:14px;">
            <%= user.birthday_display || "—" %>
            <% if user.age %>
              <span style="color:#9ca3af;">（<%= user.age %>歳）</span>
            <% end %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;font-size:14px;">
            <%= user.gender_label %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;">
            <% if @signed_user_ids.include?(user.id) %>
              <span style="color:#059669;">署名済</span>
            <% else %>
              <span style="color:#9ca3af;">—</span>
            <% end %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;">
            <% count = user.medical_questionnaires.size %>
            <%= count.positive? ? "#{count} 件" : "—" %>
            <%# 禁忌はカルテを開かなくても分かるようにする。
                latest_submitted_questionnaire は読み込み済みの関連から絞るため
                行ごとの追加クエリは出ない。 %>
            <% q = user.latest_submitted_questionnaire %>
            <% if q&.contraindicated? %>
              <span title="<%= q.contraindication_reasons.join(" / ") %>"
                    style="display:inline-block;margin-left:6px;padding:1px 6px;border-radius:4px;
                           background:#fef2f2;color:#dc2626;border:1px solid #fecaca;
                           font-size:12px;white-space:nowrap;">施術不可</span>
            <% elsif q&.needs_confirmation? %>
              <span title="<%= q.confirmation_reasons.join(" / ") %>"
                    style="display:inline-block;margin-left:6px;padding:1px 6px;border-radius:4px;
                           background:#fffbeb;color:#b45309;border:1px solid #fde68a;
                           font-size:12px;white-space:nowrap;">要確認</span>
            <% end %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;text-align:right;">
            <%= link_to "カルテを開く", karte_user_path(user),
                  style: "color:#1d4ed8;text-decoration:none;white-space:nowrap;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @users.empty? %>
    <p style="padding:40px 0;text-align:center;color:#9ca3af;">
      <%= @q.present? ? "該当する方が見つかりませんでした。" : "対象の方がいません。" %>
    </p>
  <% end %>

  <%# ── ページング ───────────────────────── %>
  <% if @total_pages > 1 %>
    <div style="display:flex;gap:8px;justify-content:center;align-items:center;margin-top:24px;">
      <% if @page > 1 %>
        <%= link_to "← 前へ", karte_users_path(q: @q, page: @page - 1),
              style: "padding:8px 16px;border:1px solid #d1d5db;border-radius:6px;color:#374151;text-decoration:none;" %>
      <% end %>

      <span style="color:#6b7280;font-size:14px;padding:0 12px;">
        <%= @page %> / <%= @total_pages %>
      </span>

      <% if @page < @total_pages %>
        <%= link_to "次へ →", karte_users_path(q: @q, page: @page + 1),
              style: "padding:8px 16px;border:1px solid #d1d5db;border-radius:6px;color:#374151;text-decoration:none;" %>
      <% end %>
    </div>
  <% end %>
</div>
