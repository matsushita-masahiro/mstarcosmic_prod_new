<div class="container" style="max-width:1100px;margin:0 auto;padding:24px 16px;">
  <h2 style="font-size:22px;margin-bottom:16px;">カルテ管理</h2>

  <%= form_with url: karte_users_path, method: :get, local: true,
                style: "margin-bottom:20px;display:flex;gap:8px;max-width:520px;" do %>
    <%= text_field_tag :q, @q,
          placeholder: "お名前・カナ・会員No. で検索",
          style: "flex:1;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:15px;" %>
    <%= submit_tag "検索",
          style: "padding:10px 20px;border-radius:6px;border:1px solid #1d4ed8;background:#1d4ed8;color:#fff;cursor:pointer;" %>
    <% if @q.present? %>
      <%= link_to "クリア", karte_users_path,
            style: "padding:10px 16px;border-radius:6px;border:1px solid #d1d5db;color:#374151;text-decoration:none;" %>
    <% end %>
  <% end %>

  <p style="color:#6b7280;font-size:14px;"><%= @users.size %> 件</p>

  <table style="width:100%;border-collapse:collapse;font-size:15px;">
    <thead>
      <tr style="background:#f3f4f6;text-align:left;">
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">会員No.</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">お名前</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">カナ</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">同意書</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;">問診票</th>
        <th style="padding:10px;border-bottom:1px solid #e5e7eb;"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;"><%= format("%06d", user.id) %></td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;"><%= user.try(:name) %></td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;"><%= user.patient_profile&.name_kana %></td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;">
            <% if Consent.current_for?(user) %>
              <span style="color:#059669;">署名済</span>
            <% else %>
              <span style="color:#9ca3af;">—</span>
            <% end %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;">
            <% count = user.medical_questionnaires.size %>
            <%= count.positive? ? "#{count} 件" : "—" %>
          </td>
          <td style="padding:10px;border-bottom:1px solid #f3f4f6;text-align:right;">
            <%= link_to "カルテを開く", karte_user_path(user),
                  style: "color:#1d4ed8;text-decoration:none;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @users.empty? %>
    <p style="padding:40px 0;text-align:center;color:#9ca3af;">
      <%= @q.present? ? "該当する方が見つかりませんでした。" : "対象の方がいません。" %>
    </p>
  <% end %>
</div>
