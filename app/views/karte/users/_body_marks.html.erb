<%#
  人体図（カルテ表示用）。記入されたマーカーを重ねる。読み取り専用。

  ローカル変数:
    side       "front" / "back"
    body_marks その問診票のマーカー全件（両面ぶん。ここで絞る）

  輪郭は記入側と同じ shared/_body_outline を使う。
%>
<% colors = { "pain" => "#dc2626", "numbness" => "#2563eb",
              "stiffness" => "#d97706", "other" => "#6b7280" } %>
<% marks = body_marks.select { |m| m.side.to_s == side } %>

<div style="text-align:center;">
  <p style="font-size:13px;color:#6b7280;margin:0 0 4px;">
    <%= side == "front" ? "表" : "裏" %>
  </p>
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet"
       style="width:100%;max-width:180px;height:auto;background:#fff;
              border:1px solid #e5e7eb;border-radius:8px;">
    <%= render "shared/body_outline" %>
    <% marks.each do |mark| %>
      <circle cx="<%= (mark.x * 100).round(2) %>"
              cy="<%= (mark.y * 100).round(2) %>"
              r="2.8"
              fill="<%= colors[mark.mark_type.to_s] || colors["other"] %>"
              fill-opacity="0.7"
              stroke="#fff" stroke-width="0.6">
        <% if mark.note.present? %>
          <title><%= mark.note %></title>
        <% end %>
      </circle>
    <% end %>
  </svg>
</div>
