<div class="container" style="max-width:900px;margin:0 auto;padding:24px 16px;">
  <p style="margin-bottom:8px;">
    <%= link_to "← カルテ一覧", karte_users_path, style: "color:#6b7280;text-decoration:none;font-size:14px;" %>
  </p>

  <%# 施術メモは来店のたびに書くもので、同意書・問診票とは頻度が違う。
      同じページに置くとスクロールで通り過ぎることになるため、別画面に分けている。 %>
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;">
    <h2 style="font-size:22px;margin-bottom:4px;">
      <%= @user.name %>
      <span style="font-size:15px;color:#6b7280;">（会員No. <%= @user.karte_member_no %>）</span>
    </h2>
    <%= link_to "施術記録へ", karte_user_treatment_notes_path(@user),
          style: "padding:10px 20px;border-radius:6px;border:1px solid #1d4ed8;" \
                 "background:#1d4ed8;color:#fff;text-decoration:none;font-size:15px;white-space:nowrap;" %>
  </div>

  <p style="color:#6b7280;font-size:14px;margin-bottom:24px;">
    <%= @user.name_kana %>
    <% if @user.birthday %>
      ／ <%= @user.birthday_display %>（<%= @user.age %>歳）
    <% end %>
    ／ <%= @user.gender_label %>
    <% if @user.tel.present? %>／ <%= @user.tel %><% end %>
    <br>
    初診日: <%= @first_visit_at ? l(@first_visit_at.to_date, format: :long) : "未登録" %>
  </p>

  <%# ── 禁忌の警告 ───────────────────────────── %>
  <% if @latest_questionnaire&.contraindicated? %>
    <div style="border:2px solid #dc2626;background:#fef2f2;border-radius:8px;padding:16px;margin-bottom:24px;">
      <strong style="color:#dc2626;font-size:17px;">施術できません</strong>
      <p style="margin:6px 0 0;color:#991b1b;">
        <%= @latest_questionnaire.contraindication_reasons.join(" / ") %>
      </p>
    </div>
  <% elsif @latest_questionnaire&.needs_confirmation? %>
    <div style="border:2px solid #f59e0b;background:#fffbeb;border-radius:8px;padding:16px;margin-bottom:24px;">
      <strong style="color:#b45309;font-size:17px;">確認してください</strong>
      <p style="margin:6px 0 0;color:#92400e;">
        <%= @latest_questionnaire.confirmation_reasons.join(" / ") %>
      </p>
    </div>
  <% end %>

  <%# ── 訂正で施術判断に関わる項目が変わった ────────────────

      出すのは「訂正された」という事実だけで、前版の警告そのものは出さない。
      「ペースメーカー装着」を再掲すると、施術者は現在も装着していると
      誤読する。ここで伝えたいのは逆で、前版の警告はもう当てはまらない
      （かもしれない）から前版を見て判断してほしい、ということ。

      禁忌に関わるフラグが変わったときだけ出す。誤字や痛みの箇所の訂正で
      毎回出ると常態化して誰も読まなくなる。訂正されたこと自体は
      下の履歴に出している。

      赤（施術できません）が出ているときは出さない。あちらは
      「いま禁忌がある」と言っており、施術は止まる。その下に別の箱を
      重ねると赤の強さが薄まる。前版を見る導線は履歴と差分に残っている。
      色は赤と並べたときに区別がつくよう、青系にしている。 %>
  <% if @latest_revision_diff&.warning_flags_changed? && !@latest_questionnaire.contraindicated? %>
    <div style="border:2px solid #2563eb;background:#eff6ff;border-radius:8px;padding:16px;margin-bottom:24px;">
      <strong style="color:#1d4ed8;font-size:17px;">訂正された問診票です</strong>
      <p style="margin:6px 0 0;color:#1e3a8a;line-height:1.7;">
        最新の問診票は
        <%= l @latest_revision_diff.previous.submitted_at.to_date, format: :long %>
        提出分を訂正したものです。<br>
        <strong>施術可否に関わる項目が変更されています。</strong>
        前の版を確認してください。
      </p>
      <p style="margin:8px 0 0;">
        <%= link_to "訂正前の版を見る",
              karte_user_path(@user, questionnaire_id: @latest_revision_diff.previous.id),
              style: "color:#1d4ed8;font-size:14px;" %>
      </p>
    </div>
  <% end %>

  <%# ── 同意書 ──────────────────────────────── %>
  <section style="margin-bottom:32px;">
    <h3 style="font-size:17px;border-bottom:2px solid #e5e7eb;padding-bottom:6px;">同意書</h3>

    <% if @consents.any? %>
      <table style="width:100%;border-collapse:collapse;font-size:15px;margin-top:12px;">
        <% @consents.each do |consent| %>
          <tr>
            <td style="padding:8px 0;border-bottom:1px solid #f3f4f6;">
              <%= consent.consent_document.title %>
              <span style="color:#9ca3af;font-size:13px;">（<%= consent.consent_document.version %>）</span>
            </td>
            <td style="padding:8px 0;border-bottom:1px solid #f3f4f6;white-space:nowrap;">
              <%= l consent.agreed_at, format: :long %>
            </td>
            <td style="padding:8px 0;border-bottom:1px solid #f3f4f6;text-align:right;">
              <% if consent.signature_image.attached? %>
                <%= image_tag consent.signature_image,
                      style: "max-height:56px;background:#fff;border:1px solid #e5e7eb;border-radius:4px;" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% else %>
      <p style="color:#9ca3af;padding:12px 0;">まだ署名がありません。</p>
    <% end %>
  </section>

  <%# ── iPad での記入開始 ───────────────────── %>
  <section style="margin-bottom:32px;">
    <h3 style="font-size:17px;border-bottom:2px solid #e5e7eb;padding-bottom:6px;">iPad で記入してもらう</h3>

    <p style="color:#6b7280;font-size:14px;margin:12px 0;">
      ボタンを押すと 30 分間有効な QR コードを表示します。iPad で読み取ってください。
    </p>

    <div style="display:flex;gap:12px;align-items:center;">
      <%= button_to "問診票の記入を開始", karte_user_intake_sessions_path(@user),
            method: :post,
            style: "padding:12px 24px;border-radius:6px;border:1px solid #1d4ed8;background:#1d4ed8;color:#fff;font-size:16px;cursor:pointer;" %>

      <% if @active_intake %>
        <span style="color:#b45309;font-size:14px;">
          有効なリンクがあります（<%= l @active_intake.expires_at, format: :short %> まで）
        </span>
        <%= button_to "無効化", karte_intake_session_path(@active_intake),
              method: :delete,
              style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;background:#fff;cursor:pointer;" %>
      <% end %>
    </div>
    <p style="color:#9ca3af;font-size:13px;margin-top:8px;">
      ※ 再度押すと新しい QR を発行します（古いリンクは自動的に無効になります）
    </p>
  </section>

  <%# ── 問診票 ──────────────────────────────── %>
  <section>
    <h3 style="font-size:17px;border-bottom:2px solid #e5e7eb;padding-bottom:6px;">問診票</h3>
    <% if @questionnaires.any? %>
      <%# 提出履歴。1件でも常に出す。
          行をクリックするとその回の内容が下に開く。既定は最新。

          【列幅について】
          reserves.scss の `thead, tbody tr { display:table; width:100%; table-layout:fixed }`
          がスコープ無しで全アプリのテーブルに効いている（予約カレンダーの
          スクロール実装がこれに依存しているため、あちらは触らない）。
          つまりこの表も fixed で組まれる。打ち消すのではなく明示幅を与える。

          幅を指定しないと日付セルが潰れ、nowrap の中身が隣の「様式」セルに
          はみ出して重なる（以前 width:1% で 9px に化けていた）。
          逆に table-layout:auto で打ち消すと、各 tr が display:table で
          独立したテーブルボックスになる構造は変わらないため、
          行ごとに列幅がばらつき（実測で最大54pxのズレ）表として読めなくなる。
          fixed を受け入れて日付列に固定幅を置くのが、この CSS 環境では正解。

          日付は「2026年08月03日(月)」で桁数が一定。必要幅の実測は
          通常 165px / 選択中（太字）169px で、フォント差を見込んで
          14em(210px) を置いている。「下書き」表示はこれより短い。

          この修正は 2 回失われている（bc9cf9c → d181354 の修正を 666b6d1 が
          古い版で上書き）。test/system/karte/questionnaire_history_test.rb が
          セル座標を実測して固定しているので、幅を変えるならそちらも見ること。 %>
      <table style="width:100%;border-collapse:collapse;font-size:15px;margin-top:12px;">
        <% @questionnaires.each do |q| %>
          <% selected = (q.id == @questionnaire.id) %>
          <tr style="background:<%= selected ? "#eff6ff" : "transparent" %>;">
            <td style="padding:10px;border-bottom:1px solid #f3f4f6;white-space:nowrap;width:14em;">
              <%= link_to karte_user_path(@user, questionnaire_id: q.id),
                    style: "text-decoration:none;color:#{selected ? '#1d4ed8' : '#374151'};" \
                           "font-weight:#{selected ? '600' : '400'};" do %>
                <%= q.submitted_at ? l(q.submitted_at.to_date, format: :long) : "下書き" %>
              <% end %>

              <%# 訂正版か、独立した提出かを区別できるようにする。
                  この区別が無いと「8/3 の訂正」と「2回目の来店で取り直した問診」が
                  同じに見え、施術判断の読み違いになる。

                  セルは width:14em(210px) の nowrap。日付が実測 165〜169px で、
                  ここに入れる行は 12px で約 130px に収めてある。
                  長くすると隣の「様式」列へはみ出す（過去に2回壊れている）。 %>
              <% if q.previous_version %>
                <% origin = q.previous_version.submitted_at %>
                <div style="font-size:12px;color:#b45309;margin-top:2px;"><%=
                  origin ? l(origin.to_date, format: :short) : "下書き"
                %> の訂正（<%= q.revision %>版目）</div>
              <% end %>

              <%# 署名の有無。出すのは「無い」ときだけにする。
                  これから提出されるものは必ず署名を伴うので、
                  「あり」を全行に出しても情報が増えず、
                  日付セル（width:14em の nowrap）を無駄に埋めるだけになる。
                  下書きには出さない（まだ署名する段階に来ていない）。 %>
              <% if !q.status_draft? && !q.signed? %>
                <div style="font-size:12px;color:#9ca3af;margin-top:2px;">署名なし</div>
              <% end %>
            </td>
            <td style="padding:10px;border-bottom:1px solid #f3f4f6;font-size:13px;color:#9ca3af;white-space:nowrap;">
              様式 <%= q.form_version %>
            </td>
            <td style="padding:10px;border-bottom:1px solid #f3f4f6;font-size:13px;">
              <% if q.contraindicated? %>
                <span style="color:#dc2626;">⚠ <%= q.contraindication_reasons.join(" / ") %></span>
              <% elsif q.needs_confirmation? %>
                <span style="color:#b45309;">⚠ <%= q.confirmation_reasons.join(" / ") %></span>
              <% end %>
            </td>
            <td style="padding:10px;border-bottom:1px solid #f3f4f6;text-align:right;white-space:nowrap;">
              <% if selected %>
                <span style="color:#1d4ed8;font-size:13px;">表示中</span>
              <% else %>
                <%= link_to "この回を見る", karte_user_path(@user, questionnaire_id: q.id),
                      style: "color:#1d4ed8;text-decoration:none;font-size:14px;" %>
              <% end %>

              <%# 訂正用のQRを発行する。上書きではなく次の版を作るため、
                  この版の内容はそのまま残る。
                  下書きには出さない（提出していない版を訂正しても意味がない）。 %>
              <% unless q.status_draft? %>
                <%= button_to "修正", karte_user_intake_sessions_path(@user, questionnaire_id: q.id),
                      form: { style: "display:inline;margin-left:12px;" },
                      style: "padding:4px 12px;border-radius:6px;border:1px solid #d1d5db;" \
                             "background:#fff;color:#374151;font-size:13px;cursor:pointer;" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>

      <%# 履歴から明示的に選んだときは、全設問を開いた状態で出す。
          最新をそのまま開いたときは要点だけ見る運用が多いため折りたたむ。 %>
      <%= render "karte/users/questionnaire",
            questionnaire: @questionnaire,
            revision_diff: @revision_diff,
            expanded: params[:questionnaire_id].present? %>
    <% else %>
      <p style="color:#9ca3af;padding:12px 0;">まだ問診票がありません。</p>
    <% end %>
  </section>
</div>
