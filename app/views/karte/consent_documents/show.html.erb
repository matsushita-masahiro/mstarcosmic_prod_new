<div class="container" style="max-width:760px;margin:0 auto;padding:24px 16px;">
  <p style="margin-bottom:8px;">
    <%= link_to "← 同意書の管理", karte_consent_documents_path,
          style: "color:#6b7280;text-decoration:none;font-size:14px;" %>
  </p>

  <h2 style="font-size:22px;margin-bottom:4px;"><%= @document.title %></h2>
  <p style="color:#6b7280;font-size:14px;margin-bottom:20px;">
    バージョン <%= @document.version %>
    ／
    <% if @document == ConsentDocument.current %>
      <span style="color:#059669;font-weight:600;">公開中</span>
    <% elsif @document.archived_at %>
      <span style="color:#9ca3af;">アーカイブ（<%= l @document.archived_at.to_date, format: :long %>）</span>
    <% elsif @document.published_at %>
      <span style="color:#6b7280;">旧版（<%= l @document.published_at.to_date, format: :long %> 公開）</span>
    <% else %>
      <span style="color:#b45309;">下書き</span>
    <% end %>
    ／ 署名 <%= @signed_count %> 名
  </p>

  <% unless @document.intact? %>
    <div style="border:2px solid #dc2626;background:#fef2f2;border-radius:8px;padding:16px;margin-bottom:20px;">
      <strong style="color:#dc2626;">本文とダイジェストが一致しません</strong>
      <p style="margin:6px 0 0;color:#991b1b;font-size:14px;">
        この画面を通さずに本文が書き換えられた可能性があります。
        署名済みの場合、署名時の文言と異なるおそれがあるため、内容を確認してください。
      </p>
    </div>
  <% end %>

  <% if @signed_count.positive? %>
    <div style="border:1px solid #e5e7eb;background:#f9fafb;border-radius:8px;padding:12px 16px;margin-bottom:20px;">
      <p style="margin:0;color:#374151;font-size:14px;">
        <%= @signed_count %> 名が署名済みのため、このバージョンは編集できません。<br>
        文言を変える場合は、この内容を引き継いで新しいバージョンを作成してください。
      </p>
    </div>
  <% end %>

  <%# 患者に見えるのと同じ形で確認する。改行はそのまま反映される。 %>
  <div style="border:1px solid #e5e7eb;border-radius:8px;padding:20px;background:#fff;
              white-space:pre-wrap;line-height:1.9;font-size:15px;color:#111827;">
<%= @document.body %>
  </div>

  <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px;">
    <%= link_to "この内容を引き継いで新バージョンを作る",
          new_karte_consent_document_path(from: @document.id),
          style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;background:#fff;color:#374151;text-decoration:none;font-size:15px;" %>

    <% if @signed_count.zero? %>
      <%= link_to "編集", edit_karte_consent_document_path(@document),
            style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;background:#fff;color:#374151;text-decoration:none;font-size:15px;" %>
    <% end %>

    <% if @document != ConsentDocument.current %>
      <%# 公開すると current が切り替わり、全員が未署名扱いになる。
          900名規模の再署名が発生するため、件数を出して確認させる。 %>
      <% current_signed = ConsentDocument.current&.consents&.count.to_i %>
      <%= button_to "このバージョンを公開する", publish_karte_consent_document_path(@document),
            method: :post,
            form: { data: { turbo_confirm:
              "公開すると、以降は全員が未署名扱いになります。" \
              "現在のバージョンに署名済みの #{current_signed} 名も、" \
              "次回来店時に再署名が必要になります。よろしいですか？" } },
            style: "padding:10px 20px;border-radius:6px;border:1px solid #1d4ed8;background:#1d4ed8;color:#fff;font-size:15px;cursor:pointer;" %>
    <% end %>

    <% if @document.published_at && @document.archived_at.nil? %>
      <%= button_to "アーカイブ", archive_karte_consent_document_path(@document),
            method: :post,
            form: { data: { turbo_confirm:
              "アーカイブすると、このバージョンは使われなくなります。" \
              "他に公開中のバージョンが無い場合、患者側の同意書ページが開けなくなります。" } },
            style: "padding:10px 20px;border-radius:6px;border:1px solid #d1d5db;background:#fff;color:#374151;font-size:15px;cursor:pointer;" %>
    <% end %>

    <% if @signed_count.zero? && @document.published_at.nil? %>
      <%= button_to "削除", karte_consent_document_path(@document),
            method: :delete,
            form: { data: { turbo_confirm: "削除します。よろしいですか？" } },
            style: "padding:10px 20px;border-radius:6px;border:1px solid #fecaca;background:#fff;color:#dc2626;font-size:15px;cursor:pointer;" %>
    <% end %>
  </div>
</div>
