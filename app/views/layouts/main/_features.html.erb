<style>
    .sp-about-button {
        display: none;
    }
    
    .about-button {
        display: block;
    }
    
    @media screen and (max-width: 768px) {
        
        .sp-about-button {
            display: block;
            text-align: center;
            
        } 
        
        .sp-about-button img {
            margin: 50px 0;
            width: 80%;
        }
        
         .about-button {
            display: none;
         }

    }

    /* エステ / 整体セクション。既存の #main-top .metatron-features は ID を含むため、
       上書きには同じく #main-top から始める必要がある */
    #main-top .metatron-features.esthe-features {
        background: #faf7f2;
        /* metatron-features 由来の margin-top:50px を打ち消し、
           直上の水色セクションとベージュを隙間なく接させる */
        margin-top: 0;
    }

    #main-top .esthe-features .esthe-note {
        color: #e60000;
        font-size: 1vw;
        margin-top: 15px;
    }

    /* /esthe へのボタン。値は .about-button を踏襲するが、依存はさせず独立して定義する。
       注記のすぐ下なので上マージンは .about-button の 50px より控えめにしている */
    /* 左カラムだけ赤字注記があり本文量も違うため、カラムを flex column にして
       ボタンを下端に寄せ、左右で上端を揃える。#esthe-seitai 配下に限定しており
       #metatron-features 側の .metatron-feature-each には影響しない */
    #main-top .esthe-features .metatron-feature-each {
        display: flex;
        flex-direction: column;
    }

    /* flex 化すると画像は直接の flex アイテムになり text-align: center が効かないため、
       画像だけ align-self で中央に戻す。本文の div は stretch のままにして折り返し幅を保つ */
    #main-top .esthe-features .metatron-feature-each .feature-img {
        align-self: center;
    }

    #main-top .esthe-features .esthe-link-wrap,
    #main-top .esthe-features .seitai-link-wrap {
        /* auto で下端に寄せる。margin-top は auto に使うため、
           直前の要素との最低限の間隔は padding-top で確保する */
        margin-top: auto;
        padding-top: 30px;
        text-align: center;
    }

    #main-top .esthe-features .esthe-link,
    #main-top .esthe-features .seitai-link {
        display: inline-block;
        width: 18vw;
    }

    #main-top .esthe-features .esthe-link:hover,
    #main-top .esthe-features .seitai-link:hover {
        opacity: 0.8;
    }

    @media screen and (max-width: 792px) {
        #main-top .esthe-features .esthe-note {
            font-size: 11px;
        }

        #main-top .esthe-features .esthe-link,
        #main-top .esthe-features .seitai-link {
            width: 80%;
        }
    }


</style>
