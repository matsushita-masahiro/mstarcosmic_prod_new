<%#
  人体図（表・裏）。
  viewBox は 0 0 100 100 の正規化座標系。JS 側は 0.0〜1.0 の相対座標で扱うため
  cx = x * 100 で対応する。図の差し替え時も座標系を変えないこと。
%>
<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet"
     data-body-map-target="<%= side %>"
     style="width:100%;max-width:200px;height:auto;background:#fff;border:1px solid #e5e7eb;border-radius:8px;cursor:crosshair;touch-action:manipulation;">
  <g fill="none" stroke="#4b5563" stroke-width="0.8" stroke-linejoin="round">
    <%# 頭 %>
    <ellipse cx="50" cy="9" rx="6" ry="7.5"/>
    <%# 首 %>
    <path d="M46.5 16 L46.5 19 M53.5 16 L53.5 19"/>
    <%# 胴体 %>
    <path d="M46.5 19 C40 20 34 22 32 26 L29 44 L33 45 L35 34 L35 58 L65 58 L65 34 L67 45 L71 44 L68 26 C66 22 60 20 53.5 19 Z"/>
    <%# 腕 %>
    <path d="M32 26 L27 46 L25 60 M68 26 L73 46 L75 60"/>
    <%# 手 %>
    <path d="M25 60 L23.5 66 M25 60 L25 66.5 M25 60 L26.5 66 M75 60 L73.5 66 M75 60 L75 66.5 M75 60 L76.5 66"/>
    <%# 脚 %>
    <path d="M35 58 L36 78 L37 94 L43 94 L44 78 L47 60 M65 58 L64 78 L63 94 L57 94 L56 78 L53 60"/>
    <%# 足 %>
    <path d="M37 94 L36 97 L43.5 97 L43 94 M63 94 L64 97 L56.5 97 L57 94"/>
  </g>
</svg>
