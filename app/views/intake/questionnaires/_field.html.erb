<%#
  設問1件を描画する。MedicalQuestionnaireForm の定義に対応。

  注意: ERB の case 式は case と最初の when の間に出力を挟めない。
  空行やコメントを入れると SyntaxError になるため密着させること。
  また ERB コメントは入れ子を解釈しないため、閉じ記号を本文に含めないこと。

  name は必ず answers[キー名] の形にする（JS 側の収集がこの形式に依存）。
  boolean / radio / select は value と表示ラベルを分離する。

  前版からの修正: サブ項目・付随項目の show_when は _sub 側の枠が持つ。
  前版は入力欄だけを隠していたため、条件を満たさないときも
  「1日の本数」などのラベルが出たままになっていた。
%>
<% show_when = question[:show_when] %>
<div class="q-field"
     <% if show_when %>
       data-conditional="true"
       data-depends-on="<%= show_when[:key] %>"
       data-depends-value="<%= Array(show_when[:values] || show_when[:value]).join(",") %>"
       hidden
     <% end %>>

<% case question[:type]
   when :boolean %>
  <div class="q-choices">
    <% MedicalQuestionnaireForm::YES_NO.each do |opt| %>
      <label class="q-choice">
        <input type="radio" name="answers[<%= question[:key] %>]" value="<%= opt[:value] %>">
        <%= opt[:label] %>
      </label>
    <% end %>
  </div>
<% when :radio %>
  <div class="q-choices">
    <% question[:options].each do |opt| %>
      <label class="q-choice">
        <input type="radio" name="answers[<%= question[:key] %>]" value="<%= opt[:value] %>">
        <%= opt[:label] %>
      </label>
    <% end %>
  </div>
<% when :select %>
  <select class="q-select-lg" name="answers[<%= question[:key] %>]">
    <option value="">選択してください</option>
    <% question[:options].each do |opt| %>
      <option value="<%= opt[:value] %>"><%= opt[:label] %></option>
    <% end %>
  </select>
<% when :checkboxes %>
  <div class="q-choices">
    <% question[:options].each do |opt| %>
      <label class="q-choice">
        <input type="checkbox" name="answers[<%= question[:key] %>][]" value="<%= opt %>">
        <%= opt %>
      </label>
    <% end %>
  </div>
<% when :text %>
  <input type="text" class="q-text" name="answers[<%= question[:key] %>]">
<% when :handwriting %>
  <%= render "intake/questionnaires/handwriting", key: question[:key] %>
<% end %>

<% if question[:other] %>
  <div class="q-sub">
    <p class="q-sub-label"><%= question[:other][:label] %></p>
    <input type="text" class="q-text" name="answers[<%= question[:other][:key] %>]">
  </div>
<% end %>

<% if question[:detail] %>
  <%= render "intake/questionnaires/sub", sub: question[:detail] %>
<% end %>

<% Array(question[:subs]).each do |sub| %>
  <%= render "intake/questionnaires/sub", sub: sub %>
<% end %>
</div>
